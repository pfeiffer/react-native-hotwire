{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": { "context": "default", "pull_to_refresh_enabled": true }
    },
    {
      "patterns": ["^/modal/"],
      "properties": { "context": "modal", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["^/close$"],
      "properties": { "presentation": "pop" }
    },
    {
      "patterns": ["^/refresh$"],
      "properties": { "presentation": "refresh" }
    },
    {
      "patterns": ["^/list"],
      "properties": { "query_string_presentation": "replace" }
    }
  ]
}
