{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": { "context": "default", "pull_to_refresh_enabled": true }
    },
    {
      "patterns": ["/new$", "/edit$", "/modal"],
      "properties": { "context": "modal", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["/numbers$"],
      "properties": { "screen": "numbers" }
    },
    {
      "patterns": ["^/$"],
      "properties": { "presentation": "clear_all" }
    }
  ]
}
