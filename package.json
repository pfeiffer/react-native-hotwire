{
  "name": "react-native-hotwire",
  "version": "0.1.3",
  "description": "Hotwire Native (Turbo + Bridge Components) for React Native and Expo",
  "license": "MIT",
  "repository": "github:pfeiffer/react-native-hotwire",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "ios",
    "android",
    "expo-module.config.json",
    "VENDOR.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "example/node_modules/.bin/tsc --noEmit",
    "test": "example/node_modules/.bin/jest",
    "test:ios": "sh scripts/test-ios.sh",
    "sync-upstream": "sh scripts/sync-upstream.sh"
  },
  "peerDependencies": {
    "@react-navigation/core": ">=7",
    "@react-navigation/elements": ">=2",
    "@react-navigation/native": ">=7",
    "expo": "*",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": ">=0.86",
    "react-native-safe-area-context": ">=5",
    "@react-navigation/native-stack": ">=7",
    "react-native-screens": ">=4"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native-stack": { "optional": true },
    "react-native-screens": { "optional": true }
  },
  "jest": {
    "preset": "./example/node_modules/jest-expo/jest-preset",
    "roots": ["<rootDir>/src"],
    "moduleDirectories": ["node_modules", "<rootDir>/example/node_modules"],
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|expo-modules-core)/)"
    ]
  },
  "devDependencies": {
    "@react-navigation/core": "^7",
    "@react-navigation/native": "^7",
    "@types/react": "~19.2.10",
    "expo-modules-core": "~3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~5.9.0"
  }
}
